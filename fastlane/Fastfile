default_platform(:ios)

platform :ios do
  before_all do
    Dir.chdir("..") do
      sh("tuist", "install")
      sh("tuist", "generate", "--no-open")
    end
  end

  desc "App Store Connect API Key 설정"
  private_lane :setup_api_key do
    key_path = ENV["ASC_KEY_FILEPATH"]

    unless File.exist?(key_path.to_s)
      UI.message("ASC key not found locally, fetching from certificates repo...")
      sh("rm", "-rf", "/tmp/asc-key")
      sh("git", "clone", "--branch", "newdok", "--depth", "1",
         "https://github.com/gomminjae/certificates.git", "/tmp/asc-key")
      key_path = "/tmp/asc-key/AuthKey_#{ENV['ASC_KEY_ID']}.p8"
    end

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_path,
    )
  end

  desc "인증서/프로비저닝 프로파일 동기화"
  lane :sync_certs do
    key = setup_api_key
    match(type: "appstore", app_identifier: ["com.newdok.app", "com.newdok.test"], api_key: key)
  end

  desc "상용 TestFlight 배포"
  lane :beta_prod do
    key = setup_api_key
    match(type: "appstore", app_identifier: ["com.newdok.app"], api_key: key)

    version = get_version_number(xcodeproj: "Modules/App/App.xcodeproj", target: "App")

    increment_build_number(
      build_number: latest_testflight_build_number(api_key: key, app_identifier: "com.newdok.app", version: version) + 1,
      xcodeproj: "Modules/App/App.xcodeproj"
    )

    build_app(
      workspace: "Newdok.xcworkspace",
      scheme: "Newdok",
      configuration: "Release",
      export_method: "app-store",
      clean: true
    )

    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
  end

  desc "테섭 TestFlight 배포"
  lane :beta_dev do
    key = setup_api_key
    match(type: "appstore", app_identifier: ["com.newdok.test"], api_key: key)

    version = get_version_number(xcodeproj: "Modules/App/App.xcodeproj", target: "App")

    increment_build_number(
      build_number: latest_testflight_build_number(api_key: key, app_identifier: "com.newdok.test", version: version) + 1,
      xcodeproj: "Modules/App/App.xcodeproj"
    )

    build_app(
      workspace: "Newdok.xcworkspace",
      scheme: "Newdok",
      configuration: "Debug",
      export_method: "app-store",
      clean: true
    )

    upload_to_testflight(api_key: key, app_identifier: "com.newdok.test", skip_waiting_for_build_processing: true)
  end

  desc "상용 + 테섭 동시 TestFlight 배포"
  lane :beta_all do
    beta_prod
    beta_dev
  end

  desc "빌드만 (CI용)"
  lane :build_only do
    build_app(
      workspace: "Newdok.xcworkspace",
      scheme: "Newdok",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      skip_archive: true
    )
  end
end
