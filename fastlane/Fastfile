default_platform(:ios)
skip_docs

REPOSITORY_ROOT = File.expand_path("..", __dir__)

platform :ios do
  before_all do
    Dir.chdir(REPOSITORY_ROOT)
    sh("mise", "exec", "--", "tuist", "install")
    sh("mise", "exec", "--", "tuist", "generate", "--no-open")
  end

  desc "App Store Connect API Key 설정"
  private_lane :setup_api_key do
    key_id = ENV["ASC_KEY_ID"].to_s
    issuer_id = ENV["ASC_ISSUER_ID"].to_s
    configured_key_path = ENV["ASC_KEY_FILEPATH"].to_s

    UI.user_error!("ASC_KEY_ID가 설정되지 않았습니다.") if key_id.empty?
    UI.user_error!("ASC_ISSUER_ID가 설정되지 않았습니다.") if issuer_id.empty?
    UI.user_error!("ASC_KEY_FILEPATH가 설정되지 않았습니다.") if configured_key_path.empty?

    key_path = File.expand_path(configured_key_path, REPOSITORY_ROOT)
    UI.user_error!("ASC_KEY_FILEPATH에 키 파일이 없습니다.") unless File.file?(key_path)

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
    )
  end

  desc "인증서/프로비저닝 프로파일 동기화"
  lane :certs do
    key = setup_api_key
    match(type: "appstore", app_identifier: ["com.newdok.app", "com.newdok.test"], api_key: key)
  end

  desc "상용 TestFlight 배포"
  lane :release do
    key = setup_api_key
    match(type: "appstore", app_identifier: ["com.newdok.app"], api_key: key)

    version = get_version_number(xcodeproj: "Modules/App/App.xcodeproj", target: "App")

    increment_build_number(
      build_number: latest_testflight_build_number(api_key: key, app_identifier: "com.newdok.app", version: version) + 1,
      xcodeproj: "Modules/App/App.xcodeproj"
    )

    build_app(
      workspace: "Newdok.xcworkspace",
      scheme: "Newdok",
      configuration: "Release",
      export_method: "app-store",
      clean: true
    )

    upload_symbols_to_crashlytics(
      dsym_path: lane_context[SharedValues::DSYM_OUTPUT_PATH],
      gsp_path: "Modules/App/Resources/GoogleService-Info.plist",
      binary_path: "Tuist/.build/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols"
    )

    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
  end

  desc "테섭 TestFlight 배포"
  lane :dev do
    key = setup_api_key
    match(type: "appstore", app_identifier: ["com.newdok.test"], api_key: key)

    version = get_version_number(xcodeproj: "Modules/App/App.xcodeproj", target: "App")

    increment_build_number(
      build_number: latest_testflight_build_number(api_key: key, app_identifier: "com.newdok.test", version: version) + 1,
      xcodeproj: "Modules/App/App.xcodeproj"
    )

    build_app(
      workspace: "Newdok.xcworkspace",
      scheme: "Newdok",
      configuration: "Debug",
      export_method: "app-store",
      clean: true
    )

    upload_symbols_to_crashlytics(
      dsym_path: lane_context[SharedValues::DSYM_OUTPUT_PATH],
      gsp_path: "Modules/App/Resources/GoogleService-Info.plist",
      binary_path: "Tuist/.build/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols"
    )

    upload_to_testflight(api_key: key, app_identifier: "com.newdok.test", skip_waiting_for_build_processing: true)
  end

  desc "상용 + 테섭 동시 TestFlight 배포"
  lane :all do
    release
    dev
  end

  desc "빌드만 (CI용)"
  lane :build do
    build_app(
      workspace: "Newdok.xcworkspace",
      scheme: "Newdok",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      skip_archive: true
    )
  end
end
